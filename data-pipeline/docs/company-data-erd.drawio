  <diagram id="company-data-erd" name="Company Data ERD">
    <mxGraphModel dx="2100" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1650" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="companies" value="&lt;b&gt;COMPANIES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; duns (stored as text)&lt;br&gt;primary_name&lt;br&gt;registered_name&lt;br&gt;legal_entity_identifier&lt;br&gt;business_entity_type&lt;br&gt;legal_form, country_code&lt;br&gt;start_date, incorporated_date&lt;br&gt;operating_status&lt;br&gt;control_ownership_type&lt;br&gt;is_standalone&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: 103832861 — Harford Bank&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="410" width="360" height="280" as="geometry"/></mxCell>
        <mxCell id="addresses" value="&lt;b&gt;COMPANY_ADDRESSES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; address_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; duns&lt;br&gt;address_role (primary/mailing/registered)&lt;br&gt;street_line_1, street_line_2&lt;br&gt;locality, county, region&lt;br&gt;country_code, postal_code&lt;br&gt;latitude, longitude&lt;br&gt;geographical_precision&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: primary = 8 W Bel Air Ave, ZIP 21001-3200; mailing = PO Box 640, ZIP 21001-0640&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="400" height="270" as="geometry"/></mxCell>
        <mxCell id="industry" value="&lt;b&gt;COMPANY_INDUSTRY_CODES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; industry_code_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; duns&lt;br&gt;code, description&lt;br&gt;classification_system_name&lt;br&gt;classification_system_code&lt;br&gt;priority, is_primary&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: Harford 522110 (NAICS) and 6022 (US SIC) are distinct rows because the systems differ.&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="390" width="400" height="230" as="geometry"/></mxCell>
        <mxCell id="employees" value="&lt;b&gt;COMPANY_EMPLOYEE_OBSERVATIONS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; employee_observation_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; duns&lt;br&gt;value, minimum_value, maximum_value&lt;br&gt;observation_date&lt;br&gt;information_scope, reliability&lt;br&gt;employee_category&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: Harford has 35 headquarters-only and 80 consolidated employees—keep as separate observations.&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="670" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="contacts" value="&lt;b&gt;COMPANY_CONTACTS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; contact_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; duns&lt;br&gt;contact_type (phone/email/website)&lt;br&gt;value, country_code, isd_code&lt;br&gt;domain_name, source&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: Harford phone 4102725000 (ISD 1) and website harfordbank.com.&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="970" width="400" height="215" as="geometry"/></mxCell>
        <mxCell id="registrations" value="&lt;b&gt;COMPANY_REGISTRATION_NUMBERS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; registration_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; duns&lt;br&gt;registration_number&lt;br&gt;type_description, type_code&lt;br&gt;registration_class, is_preferred&lt;br&gt;jurisdiction, registration_location&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: Harford has business number D06363931 and other identifiers.&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="1230" width="400" height="230" as="geometry"/></mxCell>
        <mxCell id="statements" value="&lt;b&gt;COMPANY_FINANCIAL_STATEMENTS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; financial_statement_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; duns&lt;br&gt;statement_from_date, statement_to_date&lt;br&gt;duration, information_scope&lt;br&gt;reliability, currency, units&lt;br&gt;is_audited, is_final, is_restated&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: Harford year ended 2023-12-31; Individual scope, Actual reliability, USD.&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1530" y="70" width="410" height="250" as="geometry"/></mxCell>
        <mxCell id="financialitems" value="&lt;b&gt;COMPANY_FINANCIAL_ITEMS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; financial_item_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; financial_statement_id&lt;br&gt;item_code, item_description&lt;br&gt;value, currency, units&lt;br&gt;&lt;br&gt;&lt;i&gt;Examples: Harford sales revenue 30,282,000; total assets 665,617,000; operating profit 9,484,000.&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1530" y="370" width="410" height="230" as="geometry"/></mxCell>
        <mxCell id="stock" value="&lt;b&gt;COMPANY_STOCK_EXCHANGES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; listing_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; duns&lt;br&gt;ticker_name, exchange_name&lt;br&gt;exchange_country, is_primary&lt;br&gt;&lt;br&gt;&lt;i&gt;Examples: Harford OTC:HFBK; Microsoft NASDAQ:MSFT and additional listings.&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#fff2cc;swimlaneFillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1530" y="650" width="410" height="205" as="geometry"/></mxCell>
        <mxCell id="ownership" value="&lt;b&gt;COMPANY_OWNERSHIP_LINKS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; ownership_link_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; company_duns → COMPANIES.duns&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; related_company_duns → COMPANIES.duns&lt;br&gt;relationship_role, hierarchy_level&lt;br&gt;effective_date, source&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: Microsoft Japan (690763115) is level 2; its parent is Microsoft (081466849).&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#f8cecc;swimlaneFillColor=#ffffff;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1530" y="900" width="410" height="245" as="geometry"/></mxCell>
        <mxCell id="responses" value="&lt;b&gt;FAMILY_TREE_RESPONSES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK&lt;/b&gt; response_id&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; inquiry_duns → COMPANIES.duns&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; global_ultimate_duns → COMPANIES.duns (if loaded)&lt;br&gt;transaction_id, transaction_timestamp&lt;br&gt;reported_member_count&lt;br&gt;excluded_branch_count, exclusion_criteria&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: Harford response reports 9 members and 1 excluded branch (2025-01-23).&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="790" width="420" height="260" as="geometry"/></mxCell>
        <mxCell id="members" value="&lt;b&gt;FAMILY_TREE_MEMBERS&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK, FK&lt;/b&gt; response_id&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; member_duns&lt;br&gt;member_name, hierarchy_level&lt;br&gt;optional member snapshot attributes&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: Microsoft Japan (690763115) appears at level 2 in Microsoft's response.&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="1100" width="420" height="210" as="geometry"/></mxCell>
        <mxCell id="roles" value="&lt;b&gt;FAMILY_TREE_MEMBER_ROLES&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PK, FK&lt;/b&gt; response_id, member_duns&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; role_code&lt;br&gt;role_description&lt;br&gt;&lt;br&gt;&lt;i&gt;Example: Microsoft root has Global Ultimate, Domestic Ultimate, and Parent/Headquarters roles.&lt;/i&gt;" style="swimlane;html=1;startSize=32;rounded=1;whiteSpace=wrap;overflow=hidden;spacing=10;verticalAlign=top;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="1360" width="420" height="210" as="geometry"/></mxCell>
